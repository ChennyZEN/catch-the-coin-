{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check project",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check.ps1",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Git: status and last commits",
      "type": "shell",
      "command": "git status -sb; git log --oneline -5; git tag",
      "problemMatcher": []
    },
    {
      "label": "Release: create and push tag",
      "type": "shell",
      "command": "git tag v${input:version}; if ($?) { git push origin v${input:version} }",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "version",
      "type": "promptString",
      "description": "Version number without the v (e.g. 1.4.0)"
    }
  ]
}
